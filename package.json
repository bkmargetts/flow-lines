{
  "name": "flow-lines",
  "version": "0.1.0",
  "description": "A generative art toolbox for creating beautiful SVG artwork for pen plotters",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "previews": "pnpm --filter @flow-lines/web previews:svg && node scripts/render-module-previews.mjs"
  },
  "keywords": [
    "generative-art",
    "svg",
    "pen-plotter",
    "flow-lines",
    "perlin-noise"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@huggingface/transformers": "^4.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript-eslint": "^8.65.0"
  }
}
